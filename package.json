{
  "name": "org-snapshot-mirror",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@10.29.2",
  "description": "GitHub Action to mirror organization repos with snapshot commits",
  "author": "mzwing <mzwing@mzwing.eu.org>",
  "license": "MIT",
  "keywords": [
    "github-action",
    "mirror",
    "snapshot",
    "git"
  ],
  "main": "dist/index.cjs",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --outfile=dist/index.cjs --minify --tree-shaking=true --tsconfig=tsconfig.build.json",
    "knip": "knip",
    "typecheck": "tsgo --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/exec": "^3.0.0",
    "@octokit/rest": "^22.0.1",
    "p-limit": "^7.3.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "@types/node": "^25.5.0",
    "@typescript/native-preview": "7.0.0-dev.20260329.1",
    "esbuild": "^0.27.4",
    "eslint": "^10.1.0",
    "eslint-flat-config-utils": "^3.0.2",
    "jiti": "^2.6.1",
    "knip": "^6.1.0",
    "typescript": "^6.0.2"
  }
}
